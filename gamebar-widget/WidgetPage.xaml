<Page
    x:Class="ChessLensWidget.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="Transparent">

    <Grid Padding="12,10,12,10">
        <Grid.Background>
            <!-- Opacity follows Game Bar's transparency setting for pinned widgets (see WidgetPage.xaml.cs). -->
            <SolidColorBrush x:Name="BackgroundBrush" Color="#1C1F22" />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Score, best move, side to move, depth. -->
        <Grid x:Name="Headline">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="EvalText" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" Text="…" />
            <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="BestText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TurnText" FontSize="12" Opacity="0.75" />
            </StackPanel>
            <TextBlock x:Name="DepthText" Grid.Column="2" FontSize="12" Opacity="0.6" VerticalAlignment="Top" />
        </Grid>

        <!-- Evaluation bar: White's share from the left, as in ChessLens's own bar. -->
        <Grid x:Name="EvalBar" Grid.Row="1" Height="8" Margin="0,8,0,8" CornerRadius="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="WhiteColumn" Width="1*" />
                <ColumnDefinition x:Name="BlackColumn" Width="1*" />
            </Grid.ColumnDefinitions>
            <Border Background="#EEEEEE" />
            <Border Grid.Column="1" Background="#3A3A3A" />
        </Grid>

        <StackPanel x:Name="LinesPanel" Grid.Row="2" Spacing="3">
            <TextBlock x:Name="Line1" FontSize="13" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="Line2" FontSize="13" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="Line3" FontSize="13" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock x:Name="MessageText" Grid.Row="2" FontSize="15" TextWrapping="Wrap" Visibility="Collapsed" />

        <TextBlock x:Name="GameText" Grid.Row="3" Margin="0,6,0,0" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="FairPlayText" Grid.Row="4" Margin="0,4,0,0" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
    </Grid>
</Page>
